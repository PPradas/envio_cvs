# ── Claude (Anthropic) ────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Adzuna ────────────────────────────────────────────────────────────────────
# https://developer.adzuna.com → Register → Dashboard → API Access Details
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ── InfoJobs ──────────────────────────────────────────────────────────────────
# https://developer.infojobs.net → Registro → Mi aplicación
INFOJOBS_CLIENT_ID=your_infojobs_client_id_here
INFOJOBS_CLIENT_SECRET=your_infojobs_client_secret_here

# ── LangSmith (opcional) ──────────────────────────────────────────────────────
# https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=envio-cvs
LANGSMITH_TRACING=false
